{
  "name": "sip-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/generate-qr.mjs && node scripts/generate-mail-logo.mjs",
    "build": "next build",
    "prebuild": "node scripts/generate-qr.mjs && node scripts/generate-mail-logo.mjs && node scripts/generate-headers.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "pretypecheck": "node scripts/generate-qr.mjs && node scripts/generate-mail-logo.mjs",
    "lint": "biome check && stylelint \"src/**/*.css\"",
    "format": "biome format --write",
    "test": "vitest run",
    "pretest": "node scripts/generate-qr.mjs && node scripts/generate-mail-logo.mjs",
    "test:watch": "vitest",
    "pretest:watch": "node scripts/generate-qr.mjs && node scripts/generate-mail-logo.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "audit": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "check:publication": "node scripts/check-publication.mjs",
    "mail:check": "node --env-file-if-exists=.env.local scripts/contact-mail.mjs",
    "mail:migrate": "node --env-file-if-exists=.env.local scripts/contact-mail.mjs --migrate",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.8",
    "next-intl": "4.14.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.8",
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "chrome-launcher": "1.2.2",
    "lefthook": "2.1.15",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "uqr": "0.1.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@swc/core": false,
    "@parcel/watcher": false,
    "lefthook": false
  }
}
